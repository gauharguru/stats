# SQL Server connection
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=AHS_SFM
DB_USER=sa
DB_PASSWORD=change-me
# Set to true when connecting to Azure SQL or a server with a trusted certificate
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true

# API
PORT=4000
# Generate a long random value, e.g.  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
# Hours a login token is valid (idle timeout is enforced separately)
JWT_HOURS=10
# Business time zone for "today"
BUSINESS_TIMEZONE=Asia/Kolkata

# Initial admin created by `npm run db:setup` (must change password at first login)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@12345
